# Mobile Life Assistant runs on a deterministic mock planner and an in-memory store/server by
# default, so no API keys or backend are needed to develop, test, build, or run the demo.

# Which planner to use: "mock" (default, deterministic) or a real provider you wire in.
ASSISTANT_PLANNER=mock

# Only needed if you wire a real model behind the Planner interface. Never commit a real key.
# OPENAI_API_KEY=sk-...
